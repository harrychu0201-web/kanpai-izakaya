{
  "rules": {
    ".read": false,
    ".write": false,
    "chat": {
      ".read": true,
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && !root.child('bans').child(auth.uid).exists() && newData.child('uid').val() === auth.uid && newData.child('t').val() === now && newData.parent().parent().child('chatlast').child(auth.uid).val() === now) || (!newData.exists() && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 't'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chatlast": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || data.val() <= now - 5000)"
      }
    },
    "bans": {
      ".read": "auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['at'])",
        "game": {
          ".validate": "newData.isString() && newData.val().length <= 300000"
        },
        "rec": {
          ".validate": "newData.isString() && newData.val().length <= 50000"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "lb": {
      ".read": true,
      ".indexOn": [
        "best",
        "earned",
        "own"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'best', 'earned', 'at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },
        "best": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "earned": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "own": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "fb": {
      ".read": "auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true",
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "(!data.exists() && newData.exists() && (!newData.child('uid').exists() || (auth != null && newData.child('uid').val() === auth.uid)) && newData.child('t').val() === now) || (auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true)",
        ".validate": "newData.hasChildren(['cat', 'text', 't'])",
        "cat": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 800"
        },
        "contact": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "re": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "day": {
          ".validate": "newData.isNumber()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "thr": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "ctx": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "fbreply": {
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid) || (auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true",
        "$id": {
          ".validate": "newData.hasChildren(['text', 't'])",
          "q": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "seen": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          },
          "msgs": {
            "$mid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && !newData.child('a').exists() && newData.child('t').val() === now",
              ".validate": "newData.hasChildren(['text', 't'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
              },
              "t": {
                ".validate": "newData.isNumber()"
              },
              "a": {
                ".validate": "newData.val() === true"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "notice": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true"
    },
    "reports": {
      ".read": "auth != null && auth.token.email === 'harrychu0201@gmail.com' && auth.token.email_verified === true",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && newData.child('t').val() === now",
        ".validate": "newData.hasChildren(['by', 't'])",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        }
      }
    },
    "lbx": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'day'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },
        "best": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "earned": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "own": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "day": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "ya": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
        },
        "k2": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
        },
        "dc": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "fcode": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && $code.matches(/^[A-Z2-9]{8}$/)"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$fid": {
          ".validate": "newData.isNumber() && $fid !== $uid"
        }
      }
    },
    "freq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.uid === $from",
          ".validate": "newData.isNumber() && $from !== $to"
        }
      }
    },
    "gifts": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.uid === $from && newData.child('t').val() === now && (!data.exists() || newData.child('d').val() > data.child('d').val())",
          ".validate": "newData.hasChildren(['t', 'a', 'd']) && $from !== $to",
          "t": {
            ".validate": "newData.isNumber()"
          },
          "a": {
            ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 2000"
          },
          "d": {
            ".validate": "newData.isNumber() && newData.val() <= (now + 28800000) / 86400000 + 1"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "gclaim": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$from": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
